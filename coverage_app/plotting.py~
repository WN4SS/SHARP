def plot_measurement_points_3d(output_folder, polygon_gdf, spike_points, known_height_buildings,
							   missing_height_buildings, ue_height=1.5, title_suffix="", all_antennas=None):
	"""
	3-D plot of measurement points (MPs) over the AOI.

	* MPs on buildings WITH usable height → vertical spike from z=0 to
	  z=building_height + ue_height, bright-coloured marker at the tip.
	* MPs on buildings WITHOUT usable height → small orange dot at z=ue_height.
	* MPs off buildings → tiny grey dot at z=ue_height.
	* Building footprints are drawn as semi-transparent outlines so the
	  spikes read clearly against their context.
	"""
	os.makedirs(output_folder, exist_ok=True)

	all_geoms = []
	all_geoms.extend(building["geometry"] for building in known_height_buildings)
	all_geoms.extend(missing_height_buildings)
	if len(polygon_gdf) > 0:
		all_geoms.extend(list(polygon_gdf.geometry))
	if not all_geoms:
		return None

	bounds_list = [geom.bounds for geom in all_geoms if not geom.is_empty]
	minx = min(b[0] for b in bounds_list)
	miny = min(b[1] for b in bounds_list)
	maxx = max(b[2] for b in bounds_list)
	maxy = max(b[3] for b in bounds_list)
	origin_lon = (minx + maxx) / 2.0
	origin_lat = (miny + maxy) / 2.0

	# ── colour map for spike heights ───────────────────────────────────────
	spike_data = [pt for pt in spike_points if pt["status"] == "on_building_with_height"]
	spike_heights = [pt["height"] + ue_height for pt in spike_data]
	if spike_heights:
		h_min = min(spike_heights)
		h_max = max(spike_heights)
		norm = matplotlib.colors.Normalize(vmin=h_min, vmax=h_max)
		spike_cmap = colormaps["plasma"]
	else:
		norm = None
		spike_cmap = None

	# ── max z for axis limits ───────────────────────────────────────────────
	building_heights = [building["height"] for building in known_height_buildings]
	antenna_heights = [float(ant.get("height", 0.0) or 0.0) for ant in (all_antennas or [])]
	z_top = max(
		5.0,
		(max(spike_heights) if spike_heights else 0.0) * 1.20,
		(max(building_heights) if building_heights else 0.0) * 1.10 + ue_height,
		(max(antenna_heights) if antenna_heights else 0.0) * 1.15,
	)

	fig = plt.figure(figsize=(13, 9))
	ax = fig.add_subplot(111, projection="3d")
	fig.patch.set_facecolor("white")
	ax.set_facecolor("#f0f4f8")

	# ── AOI boundary ────────────────────────────────────────────────────────
	if len(polygon_gdf) > 0:
		for geom in polygon_gdf.geometry:
			if geom.is_empty:
				continue
			geoms = [geom] if geom.geom_type == "Polygon" else list(geom.geoms)
			for poly in geoms:
				coords = _polygon_to_local_xy(poly, origin_lon, origin_lat)
				closed = coords if coords[0] == coords[-1] else coords + [coords[0]]
				ax.plot([c[0] for c in closed], [c[1] for c in closed],
						[0.0] * len(closed), color="#0f172a", linewidth=1.4, alpha=0.9, zorder=5)

	# ── building footprints without height (flat outlines) ─────────────────
	for poly in missing_height_buildings:
		_add_polygon_face_3d(ax, poly, origin_lon, origin_lat, 0.0, "#e2e8f0", "#94a3b8", 0.30)

	# ── building footprints with height (translucent extruded boxes) ────────
	for building in known_height_buildings:
		_add_extruded_polygon_3d(
			ax, building["geometry"], origin_lon, origin_lat,
			building["height"], "#bfdbfe", "#3b82f6", 0.18,
		)

	# ── off-building MPs (grey dots at ue_height) ────────────────────────
	off_pts = [pt for pt in spike_points if pt["status"] == "off_building"]
	if off_pts:
		xs = []; ys = []
		for pt in off_pts:
			x_loc, y_loc = _lonlat_to_local_xy(pt["lon"], pt["lat"], origin_lon, origin_lat)
			xs.append(x_loc); ys.append(y_loc)
		ax.scatter(xs, ys, [ue_height] * len(xs), color="#94a3b8", s=3, alpha=0.45,
				   depthshade=False, zorder=3)

	# ── on-building MPs without height (orange dot at ue_height) ─────────────────
	no_ht_pts = [pt for pt in spike_points if pt["status"] == "on_building_no_height"]
	if no_ht_pts:
		xs = []; ys = []
		for pt in no_ht_pts:
			x_loc, y_loc = _lonlat_to_local_xy(pt["lon"], pt["lat"], origin_lon, origin_lat)
			xs.append(x_loc); ys.append(y_loc)
		ax.scatter(xs, ys, [ue_height] * len(xs), color="#f97316", s=8, alpha=0.70,
				   depthshade=False, zorder=6, marker="x")

	# ── spikes for MPs on buildings with known height ───────────────────────
	for pt, ht_total in zip(spike_data, spike_heights):
		x_loc, y_loc = _lonlat_to_local_xy(pt["lon"], pt["lat"], origin_lon, origin_lat)
		if norm is not None and spike_cmap is not None:
			color = to_hex(spike_cmap(norm(ht_total)))
		else:
			color = "#16a34a"
		# stem
		ax.plot([x_loc, x_loc], [y_loc, y_loc], [0.0, ht_total],
				color=color, linewidth=1.4, alpha=0.90, zorder=8)
		# tip marker
		ax.scatter([x_loc], [y_loc], [ht_total], color=color, s=18,
				   depthshade=False, zorder=9)

	# ── axis limits ──────────────────────────────────────────────────────────
	min_x_m, min_y_m = _lonlat_to_local_xy(minx, miny, origin_lon, origin_lat)
	max_x_m, max_y_m = _lonlat_to_local_xy(maxx, maxy, origin_lon, origin_lat)
	ax.set_xlim(min(min_x_m, max_x_m), max(min_x_m, max_x_m))
	ax.set_ylim(min(min_y_m, max_y_m), max(min_y_m, max_y_m))
	ax.set_zlim(0.0, z_top)
	ax.set_xlabel("Easting (m)", labelpad=10)
	ax.set_ylabel("Northing (m)", labelpad=10)
	ax.set_zlabel("Height (m)", labelpad=8)
	ax.view_init(elev=30, azim=-55)
	x_range = abs(max_x_m - min_x_m)
	y_range = abs(max_y_m - min_y_m)
	ax.set_box_aspect((max(1.0, x_range), max(1.0, y_range), max(5.0, z_top)))
	antenna_legend_handles = _plot_antennas_3d(ax, all_antennas, origin_lon, origin_lat, x_range, y_range)

	# ── colourbar for spike heights ──────────────────────────────────────────
	if spike_cmap is not None and norm is not None and spike_data:
		sm = matplotlib.cm.ScalarMappable(cmap=spike_cmap, norm=norm)
		sm.set_array([])
		cbar = fig.colorbar(sm, ax=ax, shrink=0.45, pad=0.10, aspect=18)
		cbar.set_label("MP height (building + UE) (m)", fontsize=9)
		cbar.ax.tick_params(labelsize=8)

	# ── legend ───────────────────────────────────────────────────────────────
	legend_handles = [
		mpatches.Patch(facecolor="#e2e8f0", edgecolor="#94a3b8",
					   label="Building footprint (no height data)"),
		mpatches.Patch(facecolor="#bfdbfe", edgecolor="#3b82f6",
					   label="Building with usable height"),
		mlines.Line2D([], [], color="#94a3b8", marker="o", linestyle="None",
					  markersize=4, label=f"MP off building (z = {ue_height:.1f} m)"),
		mlines.Line2D([], [], color="#f97316", marker="x", linestyle="None",
					  markersize=6, label=f"MP on building, height unknown (z = {ue_height:.1f} m)"),
		mlines.Line2D([], [], color="#16a34a", linewidth=1.5,
					  label="MP on building — spike = bldg + UE height"),
	]
	legend_handles.extend(antenna_legend_handles)
	ax.legend(handles=legend_handles, loc="upper left",
			  bbox_to_anchor=(0.01, 0.99), fontsize=8, framealpha=0.92)

	# ── stats box ────────────────────────────────────────────────────────────
	n_spike = len(spike_data)
	n_no_ht = len(no_ht_pts)
	n_off = len(off_pts)
	n_total = n_spike + n_no_ht + n_off
	stats = [
		f"Total MPs: {n_total}",
		f"Spikes (known height): {n_spike}",
		f"On building, height unknown: {n_no_ht}",
		f"Off building: {n_off}",
	]
	if spike_heights:
		stats += [
			f"Min MP height: {min(spike_heights):.1f} m",
			f"Max MP height: {max(spike_heights):.1f} m",
			f"Median: {float(np.median(spike_heights)):.1f} m",
			f"UE height offset: {ue_height:.1f} m",
		]
	ax.text2D(
		0.01, 0.62,
		"\n".join(stats),
		transform=ax.transAxes,
		fontsize=7.5,
		bbox=dict(boxstyle="round,pad=0.3", facecolor="white",
				  edgecolor="#cbd5e1", alpha=0.92),
	)

	ax.set_title(f"Measurement Point Heights — AOI 3D View{title_suffix}",
				 fontsize=12, pad=14)
	outpath = os.path.join(output_folder, f"mp_heights_3d{title_suffix}.png")
	plt.savefig(outpath, dpi=300, bbox_inches="tight", pad_inches=0.15)
	plt.close(fig)
	return outpath


def plot_grid_based_sinr_heatmap(output_folder, polygon_gdf, real_antennas, virtual_antennas, granularity=50, 
								 title_suffix="", csv_path=None):
	"""
	Builds a coarse grid and computes average SINR in each grid cell,
	then plots a heatmap of mean SINR values.
	If 'csv_path' is None, uses 'best_data.csv' from 'output_folder'.
	"""
	if csv_path is None:
		csv_path = os.path.join(output_folder, "best_data.csv")

	if not os.path.isfile(csv_path):
		print(f"[Warning] No {csv_path} found for grid-based SINR plot.")
		return
	df = pd.read_csv(csv_path)
	if df.empty:
		print(f"[Warning] {csv_path} is empty, skipping grid-based SINR plot.")
		return

	if len(polygon_gdf) > 0:
		pminx, pminy, pmaxx, pmaxy = polygon_gdf.iloc[0].geometry.bounds
		min_lon, min_lat, max_lon, max_lat = pminx, pminy, pmaxx, pmaxy
	else:
		min_lat, max_lat, min_lon, max_lon = get_plot_bounding_box(polygon_gdf, df)

	lat_bins = np.linspace(min_lat, max_lat, granularity + 1)
	lon_bins = np.linspace(min_lon, max_lon, granularity + 1)

	lat_vals = df["Latitude"].values
	lon_vals = df["Longitude"].values
	sinr_vals = df["Best Antenna SINR (dB)"].values

	lat_inds = np.digitize(lat_vals, lat_bins) - 1
	lon_inds = np.digitize(lon_vals, lon_bins) - 1

	cell_sinr_dict = {}
	for i in range(len(df)):
		ilat = lat_inds[i]
		ilon = lon_inds[i]
		if 0 <= ilat < granularity and 0 <= ilon < granularity:
			if (ilat, ilon) not in cell_sinr_dict:
				cell_sinr_dict[(ilat, ilon)] = []
			cell_sinr_dict[(ilat, ilon)].append(sinr_vals[i])

	from shapely.geometry import Polygon
	polygons = []
	avg_sinr_list = []
	for ilat in range(granularity):
		for ilon in range(granularity):
			lat0 = lat_bins[ilat]
			lat1 = lat_bins[ilat + 1]
			lon0 = lon_bins[ilon]
			lon1 = lon_bins[ilon + 1]
			poly = Polygon([(lon0, lat0), (lon0, lat1),
							(lon1, lat1), (lon1, lat0)])
			if (ilat, ilon) in cell_sinr_dict:
				mean_sinr = np.mean(cell_sinr_dict[(ilat, ilon)])
			else:
				mean_sinr = np.nan
			polygons.append(poly)
			avg_sinr_list.append(mean_sinr)

	gdf_grid = gpd.GeoDataFrame({"avg_sinr": avg_sinr_list, "geometry": polygons}, crs="EPSG:4326")
	if len(polygon_gdf) > 0:
		gdf_grid = gpd.clip(gdf_grid, polygon_gdf)

	fig, ax = plt.subplots(figsize=(8.4, 6.8))
	ax.set_title(f"Grid-Based SINR Heatmap {title_suffix}", fontsize=13, pad=12)

	vmin, vmax = compute_percentile_range(gdf_grid["avg_sinr"].values)

	gdf_grid.plot(
		column="avg_sinr",
		cmap="viridis",
		alpha=0.7,
		vmin=vmin,
		vmax=vmax,
		legend=False,
		missing_kwds={"color": "lightgrey"},
		ax=ax
	)
	# geopandas .plot() sets ax.set_aspect('equal'), which causes matplotlib
	# to expand the viewport far beyond the AOI for small polygons.
	# Reset to 'auto' so our explicit xlim/ylim are fully respected.
	ax.set_aspect('auto')

	norm = plt.Normalize(vmin=vmin, vmax=vmax)
	sm = plt.cm.ScalarMappable(norm=norm, cmap="viridis")
	sm.set_array([])

	plot_min_lat, plot_max_lat, plot_min_lon, plot_max_lon = _expand_plot_bounds(
		min_lat,
		max_lat,
		min_lon,
		max_lon,
	)
	plot_polygon_outline(ax, polygon_gdf)
	ax.set_xlim([plot_min_lon, plot_max_lon])
	ax.set_ylim([plot_min_lat, plot_max_lat])
	ax.tick_params(axis='x', labelrotation=45)
	add_basemap(ax)
	# Re-enforce limits – contextily may nudge them
	ax.set_xlim([plot_min_lon, plot_max_lon])
	ax.set_ylim([plot_min_lat, plot_max_lat])
	ax.set_xlabel("Longitude")
	ax.set_ylabel("Latitude")
	ax.yaxis.set_major_formatter(plt.FormatStrFormatter('%.3f'))
	ax.xaxis.set_major_formatter(plt.FormatStrFormatter('%.3f'))
	ax.xaxis.set_major_locator(plt.MaxNLocator(5))
	ax.yaxis.set_major_locator(plt.MaxNLocator(5))

	display_bbox = (
		plot_min_lat,
		plot_max_lat,
		plot_min_lon,
		plot_max_lon,
	)
	real_map, virt_map = build_freq_color_maps(real_antennas, virtual_antennas)
	all_ants = real_antennas + virtual_antennas
	real_drawn, virt_drawn = add_antenna_arrows(
		ax, all_ants, display_bbox,
		freq_color_map_real=real_map,
		freq_color_map_virtual=virt_map,
		arrow_scale_factor=0.12,
		arrow_mutation_scale=17,
	)
	build_legend(ax, real_map, virt_map, real_drawn, virt_drawn, inside_axes=True)
	add_inset_colorbar(ax, sm, "Average SINR (dB)", width="4.1%", height="54%", loc="upper right", borderpad=0.8)

	add_north_arrow(ax)
	add_scale_bar(ax)

	out_png = os.path.join(output_folder, f"grid_based_sinr_heatmap{title_suffix}.png")
	plt.savefig(out_png, dpi=300, bbox_inches='tight', pad_inches=0.1)
	plt.close()
	from coverage_app.cli_utils import _ok as _pok
	_pok(f"Saved grid-based SINR heatmap → {out_png}")

def plot_grid_and_stations(polygons_gdf, all_antennas, candidate_sites, grid_res, output_folder, title_suffix=""):
	"""
	Creates a plot showing:
	- The map of the area
	- The grid (as red dashed lines)
	- The base stations and their antennas
	"""
	fig, ax = plt.subplots(figsize=(10, 9))
	
	# Plot the polygon outline if available
	if len(polygons_gdf) > 0:
		polygons_gdf.plot(ax=ax, color='none', edgecolor='black', linewidth=1, zorder=2)
		minx, miny, maxx, maxy = polygons_gdf.iloc[0].geometry.bounds
	else:
		# Fallback to antennas bounding
		lats = [ant["lat"] for ant in all_antennas]
		lons = [ant["lon"] for ant in all_antennas]
		miny, maxy = min(lats), max(lats)
		minx, maxx = min(lons), max(lons)
	
	# Draw the grid
	x_coords = np.linspace(minx, maxx, grid_res + 1)
	y_coords = np.linspace(miny, maxy, grid_res + 1)
	
	# Vertical grid lines
	for x in x_coords:
		ax.plot([x, x], [miny, maxy], 'r--', alpha=0.7, linewidth=1.0, zorder=3)
	
	# Horizontal grid lines
	for y in y_coords:
		ax.plot([minx, maxx], [y, y], 'r--', alpha=0.7, linewidth=1.0, zorder=3)
	
	# Plot candidate sites (grid centers) in red
	candidate_lats = [site[0] for site in candidate_sites]
	candidate_lons = [site[1] for site in candidate_sites]
	ax.scatter(candidate_lons, candidate_lats, c='red', s=30, alpha=0.4, zorder=4)
	
	# Plot antennas with arrows
	real_antennas = [ant for ant in all_antennas if ant["type"] == "real"]
	virtual_antennas = [ant for ant in all_antennas if ant["type"] == "virtual"]
	
	bbox = (miny, maxy, minx, maxx)
	real_map, virt_map = build_freq_color_maps(real_antennas, virtual_antennas)
	add_antenna_arrows(ax, all_antennas, bbox, real_map, virt_map)
	
	# Add basemap
	add_basemap(ax)
	
	ax.set_xlim([minx, maxx])
	ax.set_ylim([miny, maxy])
	ax.set_title(f"Grid and Antenna Placement{title_suffix}", fontsize=12, pad=10)
	ax.set_xlabel("Longitude")
	ax.set_ylabel("Latitude")
	
	out_png = os.path.join(output_folder, f"grid_and_stations{title_suffix}.png")
	plt.savefig(out_png, dpi=300, bbox_inches='tight', pad_inches=0.1)
	plt.close()
	print(f"[Info] Saved grid and stations plot at: {out_png}")

def plot_performance_history(perf_history, output_folder, filename="channel_plan_performance_history.png"):
	"""
	Creates a plot with SINR, RSRP, RSRQ, and Throughput over the optimization process.
	"""
	df = pd.DataFrame(perf_history)
	fig, ax = plt.subplots(2, 2, figsize=(10, 8))
	fig.suptitle("Channel Plan Performance Evolution", fontsize=14)

	ax[0][0].plot(df["iteration"], df["SINR"], marker='o', color='blue')
	ax[0][0].set_title("AVG SINR (dB)")
	ax[0][0].set_xlabel("Iteration")
	ax[0][0].set_ylabel("SINR (dB)")

	ax[0][1].plot(df["iteration"], df["RSRP"], marker='o', color='red')
	ax[0][1].set_title("AVG RSRP (dBm)")
	ax[0][1].set_xlabel("Iteration")
	ax[0][1].set_ylabel("RSRP (dBm)")

	ax[1][0].plot(df["iteration"], df["RSRQ"], marker='o', color='green')
	ax[1][0].set_title("AVG RSRQ (dB)")
	ax[1][0].set_xlabel("Iteration")
	ax[1][0].set_ylabel("RSRQ (dB)")

	ax[1][1].plot(df["iteration"], df["Throughput"], marker='o', color='purple')
	ax[1][1].set_title("AVG Throughput (Mbps)")
	ax[1][1].set_xlabel("Iteration")
	ax[1][1].set_ylabel("Throughput (Mbps)")

	plt.tight_layout()
	os.makedirs(output_folder, exist_ok=True)
	outpath = os.path.join(output_folder, filename)
	plt.savefig(outpath, dpi=300, bbox_inches='tight', pad_inches=0.1)
	plt.close()
	print(f"[Info] Saved optimization performance evolution plot at: {outpath}")
	return outpath
