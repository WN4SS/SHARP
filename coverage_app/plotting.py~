SHANNON_BANDWIDTH_MHZ = 10.0   # fallback only, for CSVs written before
                               # bandwidth became an antenna attribute
BANDWIDTH_COLUMN = "Best Antenna Bandwidth (MHz)"


def bandwidth_mhz_of(df, default=SHANNON_BANDWIDTH_MHZ):
	"""Per-point channel width in MHz, as an array aligned with *df*.

	Falls back to *default* for older result files, which carry no such
	column, and for any row whose value is missing or non-positive.
	"""
	if BANDWIDTH_COLUMN not in df.columns:
		return np.full(len(df), float(default))
	bw = pd.to_numeric(df[BANDWIDTH_COLUMN], errors="coerce").to_numpy(dtype=float)
	return np.where(np.isfinite(bw) & (bw > 0.0), bw, float(default))

def compute_percentile_range(values, low=2, high=98):
	arr = np.asarray(values, dtype=float)
	arr = arr[np.isfinite(arr)]
	if arr.size == 0:
		return (0.0, 1.0)
	vmin, vmax = np.nanpercentile(arr, [low, high])
	if vmin == vmax:
		vmin -= 1.0
		vmax += 1.0
	return (vmin, vmax)

