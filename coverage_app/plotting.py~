def _axes_span_in_meters(ax):
	minx, maxx = ax.get_xlim()
	miny, maxy = ax.get_ylim()
	mid_lat = (miny + maxy) / 2.0
	meters_per_degree_lon = 111320.0 * math.cos(math.radians(mid_lat))
	width_m = abs(maxx - minx) * meters_per_degree_lon
	height_m = abs(maxy - miny) * 111320.0
	return width_m, height_m


def _choose_scale_bar_length(width_m, max_fraction=0.28):
	target_length = max(width_m * max_fraction, 1.0)
	nice_lengths = np.array([
		1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500,
		1000, 2000, 5000, 10000,
	], dtype=float)
	valid = nice_lengths[nice_lengths <= target_length]
	if valid.size > 0:
		return float(valid[-1])
	return float(target_length)


def _format_distance_label(length_m):
	if length_m >= 1000:
		km_value = length_m / 1000.0
		if float(km_value).is_integer():
			return f"{int(km_value)} km"
		return f"{km_value:.1f} km"
	return f"{int(round(length_m))} m"


def _expand_plot_bounds(min_lat, max_lat, min_lon, max_lon, margin_fraction=0.05, min_margin_m=12.0):
	"""
	Expand plot bounds with a relative margin and a small metric floor.
	This keeps tiny AOIs readable without adding the very large fixed
	degree-based padding that made small areas look lost in the frame.
	"""
	lat_span = max(0.0, float(max_lat) - float(min_lat))
	lon_span = max(0.0, float(max_lon) - float(min_lon))
	mid_lat = (float(min_lat) + float(max_lat)) / 2.0
	meters_per_degree_lon = max(111320.0 * math.cos(math.radians(mid_lat)), 1e-6)

	lat_margin = max(lat_span * margin_fraction, min_margin_m / 111320.0)
	lon_margin = max(lon_span * margin_fraction, min_margin_m / meters_per_degree_lon)

	return (
		float(min_lat) - lat_margin,
		float(max_lat) + lat_margin,
		float(min_lon) - lon_margin,
		float(max_lon) + lon_margin,
	)


def add_scale_bar(ax, length_m=None, location=(0.94, 0.075), anchor="right"):
	"""
	Draw a compact scale bar anchored in axes coordinates so it stays
	inside the map frame and away from tick labels.
	"""
	width_m, _ = _axes_span_in_meters(ax)
	if width_m <= 0:
		return

	if length_m is None:
		length_m = _choose_scale_bar_length(width_m)

	bar_fraction = min(0.36, max(0.08, length_m / width_m))
	anchor_x, y0 = location
	if anchor == "right":
		x1 = anchor_x
		x0 = x1 - bar_fraction
	else:
		x0 = anchor_x
		x1 = x0 + bar_fraction

	bg = mpatches.FancyBboxPatch(
		(x0 - 0.02, y0 - 0.025),
		bar_fraction + 0.04,
		0.08,
		transform=ax.transAxes,
		boxstyle="round,pad=0.01",
		facecolor="white",
		edgecolor="#cbd5e1",
		alpha=0.88,
		linewidth=0.8,
		zorder=6,
		clip_on=False,
	)
	ax.add_patch(bg)

	for xpos in (x0, x1):
		ax.add_line(mlines.Line2D(
			[xpos, xpos], [y0 - 0.008, y0 + 0.008],
			transform=ax.transAxes,
			color="#222",
			linewidth=1.5,
			zorder=7,
			clip_on=False,
		))
	ax.add_line(mlines.Line2D(
		[x0, x1], [y0, y0],
		transform=ax.transAxes,
		color="#222",
		linewidth=2.2,
		solid_capstyle="butt",
		zorder=7,
		clip_on=False,
	))
	ax.text(
		(x0 + x1) / 2.0,
		y0 + 0.018,
		_format_distance_label(length_m),
		transform=ax.transAxes,
		ha="center",
		va="bottom",
		fontsize=8,
		color="#222",
		zorder=8,
		clip_on=False,
	)


def _plot_antennas_3d(ax, all_antennas, origin_lon, origin_lat, x_range_m, y_range_m):
	if not all_antennas:
		return []

	station_groups = {}
	for ant in all_antennas:
		key = (
			round(float(ant["lon"]), 8),
			round(float(ant["lat"]), 8),
			ant.get("type", "real"),
		)
		group = station_groups.setdefault(key, {
			"lon": ant["lon"],
			"lat": ant["lat"],
			"type": ant.get("type", "real"),
			"height": 0.0,
			"building_height_offset": 0.0,
			"antennas": [],
		})
		group["height"] = max(group["height"], float(ant.get("height", 0.0) or 0.0))
		group["building_height_offset"] = max(
			group["building_height_offset"],
			float(ant.get("building_height_offset", 0.0) or 0.0),
		)
		group["antennas"].append(ant)

	# High-contrast pole colours: distinct from the viridis MP colormap
	type_colors = {
		"real":    "#0d47a1",  # deep cobalt blue
		"virtual": "#bf360c",  # deep burnt orange
	}
	arrow_len     = max(4.0, 0.14 * max(x_range_m, y_range_m))
	tick_half     = arrow_len * 0.13   # half-width of the 10-m ruler ticks
	tick_step     = 10.0               # draw a white notch every 10 m
	label_z_offset = max(2.5, 0.06 * y_range_m)
	legend_handles = []
	has_real  = False
	has_virtual = False
	real_counter = 0
	virt_counter = 0

	for station in station_groups.values():
		x_loc, y_loc = _lonlat_to_local_xy(station["lon"], station["lat"], origin_lon, origin_lat)
		station_type  = station["type"]
		color  = type_colors["real" if station_type == "real" else "virtual"]
		marker = "s" if station_type == "real" else "X"
		mast_height = max(0.5, float(station["height"]))
		mast_base   = float(station.get("building_height_offset", 0.0) or 0.0)

		# Sequential label
		if station_type == "real":
			real_counter += 1
			bs_label = f"R{real_counter}"
		else:
			virt_counter += 1
			bs_label = f"V{virt_counter}"

		# ── Ground-anchor diamond: marks the BS footprint at z = 0 ──
		ax.scatter(
			[x_loc], [y_loc], [0.0],
			color=color, marker="D", s=60,
			edgecolors="white", linewidths=1.0,
			depthshade=False, zorder=11,
		)

		# ── Dotted segment from ground to rooftop (only when BS is on a building) ──
		if mast_base > 0:
			ax.plot(
				[x_loc, x_loc], [y_loc, y_loc], [0.0, mast_base],
				color=color, linewidth=1.2, linestyle="dotted",
				alpha=0.55, zorder=9,
			)

		# ── Solid mast segment (rooftop → antenna tip) ──
		ax.plot(
			[x_loc, x_loc], [y_loc, y_loc], [mast_base, mast_height],
			color=color, linewidth=5.0, alpha=1.0,
			solid_capstyle="round", zorder=10,
		)

		# ── Ruler: white notch every 10 m along the mast ──
		h_tick = tick_step
		while h_tick < mast_height - 0.5:
			ax.plot(
				[x_loc - tick_half, x_loc + tick_half],
				[y_loc, y_loc],
				[h_tick, h_tick],
				color="white", linewidth=2.0, zorder=12, alpha=0.95,
			)
			h_tick += tick_step

		# ── Tip marker ──
		ax.scatter(
			[x_loc], [y_loc], [mast_height],
			color=color, marker=marker, s=100,
			edgecolors="white", linewidths=1.5,
			depthshade=False, zorder=13,
		)

		# ── Label: white text on solid coloured background ──
		ax.text(
			x_loc, y_loc, mast_height + label_z_offset,
			f"{bs_label}\n{mast_height:.0f} m",
			fontsize=9.5, fontweight="bold", color="white",
			ha="center", va="bottom", zorder=16,
			bbox=dict(
				boxstyle="round,pad=0.25",
				facecolor=color,
				edgecolor="white",
				linewidth=1.2,
				alpha=0.96,
			),
		)

		for ant in station["antennas"]:
			azimuth_rad = math.radians(float(ant.get("azimuth", 0.0)))
			dx = arrow_len * math.sin(azimuth_rad)
			dy = arrow_len * math.cos(azimuth_rad)
			ax.quiver(
				x_loc, y_loc, mast_height,
				dx, dy, 0.0,
				color=color, linewidth=1.8,
				arrow_length_ratio=0.22,
				normalize=False, zorder=11,
			)

		if station_type == "real":
			has_real = True
		else:
			has_virtual = True

	if has_real:
		legend_handles.append(
			mlines.Line2D([], [], color="#0d47a1", marker="s", linestyle="-",
						 markersize=6, linewidth=2.0,
						 label="Real BS (R1, R2, …) mast + azimuth\n(white notches = 10 m intervals)")
		)
	if has_virtual:
		legend_handles.append(
			mlines.Line2D([], [], color="#bf360c", marker="X", linestyle="-",
						 markersize=6, linewidth=2.0,
						 label="Virtual BS (V1, V2, …) mast + azimuth\n(white notches = 10 m intervals)")
		)

	return legend_handles

# 3GPP-standard thresholds for the colorbar quality labels.
# RSRP (dBm): Excellent ≥ -80, Good ≥ -90, Fair ≥ -100, Poor < -110
# SINR  (dB): Excellent ≥ 20,  Good ≥ 13,  Fair ≥ 0,    Poor < -3
_QUALITY_THRESHOLDS = {
	"RSRP (dBm)": [
		(-80,  "Excellent (≥ -80 dBm)"),
		(-90,  "Good (≥ -90 dBm)"),
		(-100, "Fair (≥ -100 dBm)"),
		(-110, "Poor (≥ -110 dBm)"),
	],
	"SINR (dB)": [
		(20, "Excellent (≥ 20 dB)"),
		(13, "Good (≥ 13 dB)"),
		(0,  "Fair (≥ 0 dB)"),
		(-3, "Poor (≥ -3 dB)"),
	],
	"Average SINR (dB)": [
		(20, "Excellent (≥ 20 dB)"),
		(13, "Good (≥ 13 dB)"),
		(0,  "Fair (≥ 0 dB)"),
		(-3, "Poor (≥ -3 dB)"),
	],
}

def _annotate_colorbar_quality_lines(cbar, mappable, label, threshold_text_x=1.18, draw_text=True):
	thresholds = _QUALITY_THRESHOLDS.get(label, [])
	if not thresholds:
		return

	vmin, vmax = mappable.get_clim()
	y_transform = cbar.ax.get_yaxis_transform()
	for value, text in thresholds:
		if vmin <= value <= vmax:
			cbar.ax.axhline(value, color="white", lw=0.8, linestyle="--", alpha=0.8)
			if draw_text:
				cbar.ax.text(
					threshold_text_x,
					value,
					text,
					va="center",
					ha="left",
					fontsize=7,
					transform=y_transform,
					color="#333",
					clip_on=False,
				)


def add_side_colorbar(fig, ax, mappable, label, size="4.5%", pad=0.18, threshold_text_x=1.18):
	"""
	Add a colorbar to the right of *ax* with 3GPP-standard quality
	threshold lines (RSRP or SINR). The colorbar is appended through an
	axes divider so it gets dedicated space instead of drawing over the map.
	"""
	divider = make_axes_locatable(ax)
	cax = divider.append_axes("right", size=size, pad=pad)
	cbar = fig.colorbar(mappable, cax=cax, orientation="vertical")
	cbar.ax.yaxis.set_ticks_position("left")
	cbar.ax.yaxis.set_label_position("left")
	cbar.ax.tick_params(labelsize=8)
	cbar.set_label(label, size=9, labelpad=6)
	_annotate_colorbar_quality_lines(
		cbar,
		mappable,
		label,
		threshold_text_x=threshold_text_x,
		draw_text=True,
	)
	return cbar


def add_inset_colorbar(ax, mappable, label, width="3.6%", height="52%", loc="upper right", borderpad=0.9):
	"""
	Draw a compact inset colorbar inside the map axes to keep the map itself
	dominant in the exported image for small AOIs.
	"""
	cax = inset_axes(ax, width=width, height=height, loc=loc, borderpad=borderpad)
	cax.set_facecolor((1.0, 1.0, 1.0, 0.85))
	cbar = plt.colorbar(mappable, cax=cax, orientation="vertical")
	cbar.ax.tick_params(labelsize=7)
	cbar.ax.set_title("Avg\nSINR", fontsize=7, pad=4)
	_annotate_colorbar_quality_lines(cbar, mappable, label, draw_text=False)
	return cbar

def build_freq_color_maps(real_antennas, virtual_antennas):
	"""
	Build color maps for real and virtual antennas based on frequencies.
	"""
	real_freqs = sorted({ant["frequency"] for ant in real_antennas})
	virt_freqs = sorted({ant["frequency"] for ant in virtual_antennas})

	blues = colormaps["Blues"]
	rdpu = colormaps["RdPu"]

	real_color_map = {}
	for i, freq in enumerate(real_freqs):
		frac = (i + 1) / (len(real_freqs) + 1)
		color_ = blues(frac)
		real_color_map[freq] = to_hex(color_)

	virtual_color_map = {}
	for i, freq in enumerate(virt_freqs):
		frac = (i + 1) / (len(virt_freqs) + 1)
		color_ = rdpu(frac)
		virtual_color_map[freq] = to_hex(color_)

	return real_color_map, virtual_color_map

def add_antenna_arrows(
	ax,
	all_antennas,
	bounding_box,
	freq_color_map_real,
	freq_color_map_virtual,
	arrow_scale_factor=0.08,
	arrow_mutation_scale=12,
):
	"""
	Draw antennas as scatter + arrow annotation in the map.
	Returns sets of frequencies actually drawn (for legend).
	"""
	min_lat, max_lat, min_lon, max_lon = bounding_box
	d_lat = max_lat - min_lat
	d_lon = max_lon - min_lon
	arrow_scale = arrow_scale_factor * max(d_lat, d_lon)

	real_drawn_freqs = set()
	virt_drawn_freqs = set()

	for ant in all_antennas:
		lat = ant["lat"]
		lon = ant["lon"]
		if not (min_lat <= lat <= max_lat and min_lon <= lon <= max_lon):
			continue
		freq_ = ant["frequency"]
		typ_ = ant.get("type", "real")
		if typ_ == "real":
			color_ = freq_color_map_real.get(freq_, "#0000FF")
			marker_shape = "s"
			real_drawn_freqs.add(freq_)
		else:
			color_ = freq_color_map_virtual.get(freq_, "#FF00FF")
			marker_shape = "X"
			virt_drawn_freqs.add(freq_)

		ax.scatter(lon, lat, color=color_, marker=marker_shape, s=70,
				   edgecolors="black", linewidths=0.8, zorder=5)

		az_deg = ant["azimuth"]
		az_rad = math.radians(az_deg)
		lon_scale_factor = math.cos(math.radians(float(lat)))  # Accounts for longitude compression
		'''
		Longitude gets compressed as it gets father away form the equator by a factor of cos(latitude). 
		To consider this compression we divide by cos(latitude) when computing our end point for longitude
		'''
		end_lat = float(lat) + float(arrow_scale) * float(math.cos(az_rad))
		end_lon = float(lon) + (float(arrow_scale) * float(math.sin(az_rad)) / lon_scale_factor)

		ax.annotate(
			"",
			xy=(end_lon, end_lat),
			xytext=(lon, lat),
			arrowprops=dict(
				arrowstyle="simple",
				fc=color_,
				ec="black",
				lw=0.5,
				shrinkA=0,
				shrinkB=0,
				mutation_scale=arrow_mutation_scale
			),
			zorder=6
		)
	return real_drawn_freqs, virt_drawn_freqs

def build_legend(
	ax,
	freq_color_map_real,
	freq_color_map_virtual,
	real_shown_freqs,
	virt_shown_freqs,
	inside_axes=False,
):
	"""
	Construct a legend showing real/virtual frequencies in the plot.
	"""
	legend_handles = []

	for freq_ in sorted(freq_color_map_real.keys()):
		if freq_ in real_shown_freqs:
			line = mlines.Line2D(
				[], [], color=freq_color_map_real[freq_], marker='s', linestyle='None',
				markersize=10, label=f"Real Antenna at {freq_:.1f} MHz"
			)
			legend_handles.append(line)

	for freq_ in sorted(freq_color_map_virtual.keys()):
		if freq_ in virt_shown_freqs:
			line = mlines.Line2D(
				[], [], color=freq_color_map_virtual[freq_], marker='X', linestyle='None',
				markersize=10, label=f"Virtual Antenna at {freq_:.1f} MHz"
			)
			legend_handles.append(line)

	if legend_handles:
		if inside_axes:
			ncols = 1 if len(legend_handles) <= 2 else 2
			legend = ax.legend(
				handles=legend_handles,
				loc="lower left",
				bbox_to_anchor=(0.015, 0.02),
				ncol=ncols,
				frameon=True,
				framealpha=0.92,
				facecolor="white",
				fontsize=7.5,
				borderaxespad=0,
			)
		else:
			ncols = max(1, len(legend_handles) // 3 + (1 if len(legend_handles) % 3 else 0))
			legend = ax.legend(
				handles=legend_handles,
				loc="upper center",
				bbox_to_anchor=(0.5, -0.22),
				ncol=ncols,
				frameon=True,
				framealpha=0.9,
				facecolor="white",
				fontsize=8,
				borderaxespad=0,
			)
		return legend

def _lonlat_to_local_xy(lon, lat, origin_lon, origin_lat):
	meters_per_lon_degree = 111320.0 * math.cos(math.radians(origin_lat))
	x = (lon - origin_lon) * meters_per_lon_degree
	y = (lat - origin_lat) * 111320.0
	return x, y

def _polygon_to_local_xy(polygon, origin_lon, origin_lat):
	return [_lonlat_to_local_xy(lon, lat, origin_lon, origin_lat) for lon, lat in polygon.exterior.coords]

def _add_polygon_face_3d(ax, polygon, origin_lon, origin_lat, z_value, facecolor, edgecolor, alpha):
	coords = _polygon_to_local_xy(polygon, origin_lon, origin_lat)
	if len(coords) < 3:
		return
	face = [[(x, y, z_value) for x, y in coords]]
	collection = Poly3DCollection(face, facecolors=facecolor, edgecolors=edgecolor,
		linewidths=0.35, alpha=alpha)
	ax.add_collection3d(collection)

	closed_coords = coords if coords[0] == coords[-1] else coords + [coords[0]]
	xs = [xy[0] for xy in closed_coords]
	ys = [xy[1] for xy in closed_coords]
	zs = [z_value] * len(closed_coords)
	ax.plot(xs, ys, zs, color=edgecolor, linewidth=0.45, alpha=min(1.0, alpha + 0.2))

def _add_extruded_polygon_3d(ax, polygon, origin_lon, origin_lat, height, facecolor, edgecolor, alpha):
	coords = _polygon_to_local_xy(polygon, origin_lon, origin_lat)
	if len(coords) < 3:
		return

	closed_coords = coords if coords[0] == coords[-1] else coords + [coords[0]]
	if height <= 0:
		_add_polygon_face_3d(ax, polygon, origin_lon, origin_lat, 0.0, facecolor, edgecolor, alpha)
		return

	top_face = [[(x, y, height) for x, y in closed_coords]]
	side_faces = []
	for idx in range(len(closed_coords) - 1):
		x1, y1 = closed_coords[idx]
		x2, y2 = closed_coords[idx + 1]
		side_faces.append([
			(x1, y1, 0.0),
			(x2, y2, 0.0),
			(x2, y2, height),
			(x1, y1, height),
		])

	faces = top_face + side_faces
	collection = Poly3DCollection(faces, facecolors=facecolor, edgecolors=edgecolor,
		linewidths=0.35, alpha=alpha)
	ax.add_collection3d(collection)

	xs = [xy[0] for xy in closed_coords]
	ys = [xy[1] for xy in closed_coords]
	ax.plot(xs, ys, [0.0] * len(closed_coords), color=edgecolor, linewidth=0.35, alpha=0.45)
	ax.plot(xs, ys, [height] * len(closed_coords), color=edgecolor, linewidth=0.45, alpha=0.75)

def get_plot_bounding_box(gdf_polygon, df_points):
	"""
	Determines bounding box for polygons + coverage points.
	"""
	lat_vals = df_points["Latitude"].values
	lon_vals = df_points["Longitude"].values
	min_lat = np.min(lat_vals)
	max_lat = np.max(lat_vals)
	min_lon = np.min(lon_vals)
	max_lon = np.max(lon_vals)

	if len(gdf_polygon) > 0:
		pminx, pminy, pmaxx, pmaxy = gdf_polygon.iloc[0].geometry.bounds
		min_lat = min(min_lat, pminy)
		max_lat = max(max_lat, pmaxy)
		min_lon = min(min_lon, pminx)
		max_lon = max(max_lon, pmaxx)

	return _expand_plot_bounds(min_lat, max_lat, min_lon, max_lon)

def plot_polygon_outline(ax, gdf_polygon):
	if len(gdf_polygon) > 0:
		gdf_polygon.plot(ax=ax, color="none", edgecolor="black", linewidth=1, zorder=4)

def add_basemap(ax):
	xlim = ax.get_xlim()
	ylim = ax.get_ylim()
	try:
		ctx.add_basemap(ax, headers={"User-Agent": "SHARP/1.0 (bobfrenc@buffalo.edu)"}, crs="EPSG:4326")
	except Exception as exc:
		print(f"[Warning] Basemap unavailable: {exc}")
	finally:
		ax.set_xlim(xlim)
		ax.set_ylim(ylim)

