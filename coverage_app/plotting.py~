	ax.xaxis.set_major_formatter(plt.FormatStrFormatter('%.3f'))
	ax.yaxis.set_major_formatter(plt.FormatStrFormatter('%.3f'))

	real_map, virt_map = build_freq_color_maps(real_antennas, virtual_antennas)
