def plot_best_throughput_heatmap(output_folder, polygon_gdf, real_antennas, virtual_antennas, title_suffix="", csv_path=None):
	"""
	Plot all coverage points color-coded by estimated throughput in Mbps.
	Throughput is computed from SINR using Shannon capacity over the
	channel each point was actually served on: C = B * log2(1 + SINR).
	"""
	if csv_path is None:
		csv_path = os.path.join(output_folder, "best_data.csv")

	if not os.path.isfile(csv_path):
		print(f"[Warning] No {csv_path} found for throughput plot.")
		return
	df = pd.read_csv(csv_path)
	if df.empty:
		print(f"[Warning] {csv_path} is empty, skipping throughput plot.")
		return

	sinr_db = df["Best Antenna SINR (dB)"].to_numpy(dtype=float)
	throughput_mbps = np.full_like(sinr_db, np.nan, dtype=float)
	valid_mask = np.isfinite(sinr_db) & (sinr_db > -999)
	if not np.any(valid_mask):
		print(f"[Warning] {csv_path} has no valid SINR values for throughput plot.")
		return
	sinr_lin = np.power(10.0, sinr_db[valid_mask] / 10.0)
	bw_mhz = bandwidth_mhz_of(df)[valid_mask]
	throughput_mbps[valid_mask] = bw_mhz * np.log2(1.0 + np.maximum(sinr_lin, 0.0))

	fig, ax = plt.subplots(figsize=(8, 6.5))
	ax.set_title(f"Best Throughput (Mbps) Heatmap {title_suffix}", fontsize=13, pad=12)

	vmin, vmax = compute_percentile_range(throughput_mbps)

	sc = ax.scatter(df["Longitude"], df["Latitude"],
		c=throughput_mbps,
		cmap="viridis",
		vmin=vmin, vmax=vmax,
		alpha=0.75, s=10,
		edgecolors="none",
		zorder=3
	)

	plot_polygon_outline(ax, polygon_gdf)
